# ==================================================
# SERVER ENVIRONMENT VARIABLES — EXAMPLE FILE
# Copy this to .env and fill in real values
# NEVER commit .env to version control
# ==================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/dental-clinic-management

# JWT Secrets (use a random 64-char string in production)
JWT_SECRET=replace_with_secure_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_char_string
JWT_REFRESH_EXPIRE=7d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer / SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@auradental.com
EMAIL_FROM_NAME=Aura Dental Clinic

# Clinic Info (used in email templates)
CLINIC_NAME=Aura Dental Clinic
CLINIC_ADDRESS=123 Dental Lane, Suite 100, New York
